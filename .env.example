# Google Gemini API Key
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# (Optional) Override default AI model without touching code
# Available options include: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# AI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (for /about contribution graph via GitHub GraphQL API)
# Create a fine-grained or classic read-only token with public access at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
